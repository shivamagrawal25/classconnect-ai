{
  // The static site is served as assets; requests to /api/* go to the Worker
  // in worker/index.js, which calls Cloudflare Workers AI through the AI binding.
  "name": "class-connect-ai",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  // Preview builds (non-main branches) need their own copy of the binding.
  "previews": {
    "ai": {
      "binding": "AI"
    }
  }
}
